//@version=5
// =====================================================================
// STRATEGY 5: VWAP Bounce + Trend Continuation
// Pair: XAUUSD  | Timeframe: M15  | Session: London + NY
// Idea: When price is above EMA200 (uptrend), wait for pullback to VWAP +
//       bullish reversal candle → enter long. Mirror for shorts.
// =====================================================================
strategy("VWAP Bounce [Naveen]",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     pyramiding=0,
     process_orders_on_close=true)

// ───────────── INPUTS ─────────────
g1 = "📅 Session"
sess        = input.session("1230-2230", "Trade Session (IST 12:30-22:30)", group=g1)

g2 = "🎯 Risk & Targets"
slBufATR    = input.float(0.5, "SL buffer (×ATR) beyond VWAP", group=g2)
tp1R        = input.float(1.0, "TP1 (R)", group=g2)
tp2R        = input.float(2.0, "TP2 (R)", group=g2)
tp1Pct      = input.int(50, "Close % at TP1", group=g2)

g3 = "🔍 Filters"
vwapProxATR = input.float(0.4, "Max distance to VWAP (×ATR)", group=g3,
                 tooltip="Only trade when price is close to VWAP")
useRSI      = input.bool(true, "Use RSI filter (40-60 zone for entry)", group=g3)

g4 = "🔔 Alerts"
alertOn     = input.bool(true, "Enable alerts", group=g4)

// ───────────── INDICATORS ─────────────
atr   = ta.atr(14)
ema200 = ta.ema(close, 200)
rsi    = ta.rsi(close, 14)

// Anchored VWAP (resets daily)
vwapVal = ta.vwap(hlc3)

plot(vwapVal, "VWAP",   color.new(color.purple, 0), linewidth=2)
plot(ema200,  "EMA200", color.new(color.orange, 0))

// ───────────── STATE ─────────────
inSess  = not na(time(timeframe.period, sess))
trendUp = close > ema200
trendDn = close < ema200

nearVWAP = math.abs(close - vwapVal) <= atr * vwapProxATR

// Bullish reversal candle near VWAP (hammer / bullish engulfing simplified)
bullCandle = close > open and close > vwapVal and low <= vwapVal and (close - open) > (high - low) * 0.5
bearCandle = close < open and close < vwapVal and high >= vwapVal and (open - close) > (high - low) * 0.5

rsiOkLong  = not useRSI or (rsi > 40 and rsi < 65)
rsiOkShort = not useRSI or (rsi < 60 and rsi > 35)

longCond  = inSess and trendUp and nearVWAP and bullCandle and rsiOkLong  and strategy.position_size == 0
shortCond = inSess and trendDn and nearVWAP and bearCandle and rsiOkShort and strategy.position_size == 0

// ───────────── ORDERS ─────────────
if longCond
    sl = vwapVal - atr * slBufATR
    risk = close - sl
    tp1 = close + risk * tp1R
    tp2 = close + risk * tp2R
    strategy.entry("L", strategy.long)
    strategy.exit("L-TP1", from_entry="L", qty_percent=tp1Pct, limit=tp1, stop=sl)
    strategy.exit("L-TP2", from_entry="L", limit=tp2, stop=sl)

if shortCond
    sl = vwapVal + atr * slBufATR
    risk = sl - close
    tp1 = close - risk * tp1R
    tp2 = close - risk * tp2R
    strategy.entry("S", strategy.short)
    strategy.exit("S-TP1", from_entry="S", qty_percent=tp1Pct, limit=tp1, stop=sl)
    strategy.exit("S-TP2", from_entry="S", limit=tp2, stop=sl)

if not inSess and strategy.position_size != 0
    strategy.close_all(comment="EOD")

if alertOn and longCond
    alert("🟢 STRAT5 VWAP LONG "  + syminfo.ticker + " @ " + str.tostring(close,"#.##"),
          alert.freq_once_per_bar_close)
if alertOn and shortCond
    alert("🔴 STRAT5 VWAP SHORT " + syminfo.ticker + " @ " + str.tostring(close,"#.##"),
          alert.freq_once_per_bar_close)

plotshape(longCond,  "L", shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(shortCond, "S", shape.triangledown, location.abovebar, color.red,  size=size.small)
bgcolor(inSess ? color.new(color.green, 95) : na)
