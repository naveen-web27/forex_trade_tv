//@version=5
// =====================================================================
// STRATEGY 1: Asian Range Breakout + CPR Confluence
// Pair: XAUUSD  | Timeframe: M15  | Session: London (12:30-16:30 IST)
// Author: Naveen | Funded-account safe (fixed SL, 1 trade/dir/day)
// =====================================================================
strategy("Asian Breakout + CPR [Naveen]",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.5,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true)

// ───────────── INPUTS ─────────────
grp1 = "📅 Sessions (Exchange Time)"
asianSess   = input.session("0300-1200", "Asian Session",  group=grp1, tooltip="Asian range build. Default = 03:00-12:00 broker time ≈ 03:30-12:30 IST")
londonSess  = input.session("1230-1630", "London Trade Window", group=grp1)

grp2 = "🎯 Risk & Targets"
riskPct     = input.float(0.5, "Risk % per trade", minval=0.1, maxval=2.0, step=0.1, group=grp2)
slBufferATR = input.float(0.2, "SL buffer (× ATR14)", group=grp2)
tp1R        = input.float(1.0, "TP1 (R multiple)", group=grp2)
tp2R        = input.float(2.0, "TP2 (R multiple)", group=grp2)
tp1Pct      = input.int(50, "Close % at TP1", minval=10, maxval=90, group=grp2)

grp3 = "🔍 Filters"
useCPR      = input.bool(true,  "Require CPR confluence", group=grp3)
maxCPRwidth = input.float(0.6,  "Skip if CPR width > % of price", step=0.05, group=grp3)
useEMA      = input.bool(true,  "Require EMA50 trend confluence", group=grp3)

grp4 = "🔔 Alerts"
alertOn     = input.bool(true, "Enable alerts", group=grp4)

// ───────────── CPR (Daily) ─────────────
dH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
dL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
dC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
pivot = (dH + dL + dC) / 3
bc    = (dH + dL) / 2
tc    = (pivot - bc) + pivot
cprTop = math.max(tc, bc)
cprBot = math.min(tc, bc)
cprWidthPct = (cprTop - cprBot) / close * 100

plot(pivot, "Pivot", color.new(color.yellow,0), linewidth=2)
plot(cprTop, "TC",   color.new(color.aqua,0))
plot(cprBot, "BC",   color.new(color.aqua,0))

// ───────────── Asian Range ─────────────
inAsian   = not na(time(timeframe.period, asianSess))
inLondon  = not na(time(timeframe.period, londonSess))

var float asianHi = na
var float asianLo = na
var bool  longTaken  = false
var bool  shortTaken = false

newDay = ta.change(time("D")) != 0
if newDay
    asianHi := na
    asianLo := na
    longTaken  := false
    shortTaken := false

if inAsian
    asianHi := na(asianHi) ? high : math.max(asianHi, high)
    asianLo := na(asianLo) ? low  : math.min(asianLo, low)

plot(asianHi, "Asian High", color.new(color.lime, 0), style=plot.style_linebr)
plot(asianLo, "Asian Low",  color.new(color.red,  0), style=plot.style_linebr)

// ───────────── Indicators ─────────────
atr  = ta.atr(14)
ema50 = ta.ema(close, 50)

// ───────────── Entry Logic ─────────────
cprOk    = not useCPR or cprWidthPct <= maxCPRwidth
trendUp  = not useEMA or close > ema50
trendDn  = not useEMA or close < ema50
cprBull  = not useCPR or close > cprTop
cprBear  = not useCPR or close < cprBot

longCond  = inLondon and not longTaken  and not na(asianHi) and ta.crossover(close, asianHi) and cprOk and trendUp and cprBull
shortCond = inLondon and not shortTaken and not na(asianLo) and ta.crossunder(close, asianLo) and cprOk and trendDn and cprBear

// ───────────── Order management ─────────────
if longCond
    sl = asianLo - atr * slBufferATR
    risk = close - sl
    tp1 = close + risk * tp1R
    tp2 = close + risk * tp2R
    strategy.entry("L", strategy.long, alert_message="LONG XAUUSD breakout @ {{close}}")
    strategy.exit("L-TP1", from_entry="L", qty_percent=tp1Pct, limit=tp1, stop=sl)
    strategy.exit("L-TP2", from_entry="L", limit=tp2, stop=sl)
    longTaken := true

if shortCond
    sl = asianHi + atr * slBufferATR
    risk = sl - close
    tp1 = close - risk * tp1R
    tp2 = close - risk * tp2R
    strategy.entry("S", strategy.short, alert_message="SHORT XAUUSD breakout @ {{close}}")
    strategy.exit("S-TP1", from_entry="S", qty_percent=tp1Pct, limit=tp1, stop=sl)
    strategy.exit("S-TP2", from_entry="S", limit=tp2, stop=sl)
    shortTaken := true

// Force close at end of London session
if not inLondon and (strategy.position_size != 0)
    strategy.close_all(comment="EOD")

// ───────────── Alerts ─────────────
if alertOn and longCond
    alert("🟢 STRAT1 LONG  " + syminfo.ticker + " @ " + str.tostring(close, "#.##") +
          " | SL=" + str.tostring(asianLo - atr*slBufferATR, "#.##"),
          alert.freq_once_per_bar_close)
if alertOn and shortCond
    alert("🔴 STRAT1 SHORT " + syminfo.ticker + " @ " + str.tostring(close, "#.##") +
          " | SL=" + str.tostring(asianHi + atr*slBufferATR, "#.##"),
          alert.freq_once_per_bar_close)

// Visual markers
plotshape(longCond,  "Long",  shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(shortCond, "Short", shape.triangledown, location.abovebar, color.red,  size=size.small)
bgcolor(inAsian  ? color.new(color.blue,  92) : na)
bgcolor(inLondon ? color.new(color.green, 94) : na)
