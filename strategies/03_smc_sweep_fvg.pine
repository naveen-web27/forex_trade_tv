//@version=5
// =====================================================================
// STRATEGY 3: Liquidity Sweep + Fair Value Gap (Smart Money Concepts)
// Pair: XAUUSD  | Timeframe: M15  | Session: London + NY
// Idea: Price grabs liquidity above swing high (stops hunt), reverses,
//       creates an FVG (imbalance) → we enter SHORT on FVG retest.
//       (Mirror for longs.)
// =====================================================================
strategy("SMC Sweep + FVG [Naveen]",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     pyramiding=0,
     process_orders_on_close=true)

// ───────────── INPUTS ─────────────
g1 = "📅 Session"
sess        = input.session("1230-2230", "Trade Session (IST 12:30-22:30)", group=g1)

g2 = "🎯 Risk & Targets"
slBufATR    = input.float(0.3, "SL buffer (× ATR)", group=g2)
tp1R        = input.float(1.0, "TP1 (R)", group=g2)
tp2R        = input.float(2.5, "TP2 (R)", group=g2)
tp1Pct      = input.int(50,  "Close % at TP1", group=g2)

g3 = "🔍 Sweep & FVG params"
swingLen    = input.int(10, "Swing pivot length",   minval=3,  group=g3)
fvgMinATR   = input.float(0.3, "Min FVG size (×ATR)", group=g3, tooltip="Filters tiny gaps")
lookback    = input.int(30, "Lookback bars to find sweep", group=g3)

g4 = "🔔 Alerts"
alertOn     = input.bool(true, "Enable alerts", group=g4)

// ───────────── BASE ─────────────
atr   = ta.atr(14)
ema200 = ta.ema(close, 200)
inSess = not na(time(timeframe.period, sess))

// ───────────── Swing highs/lows ─────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow (low,  swingLen, swingLen)
var float lastSwingH = na
var float lastSwingL = na
if not na(ph)
    lastSwingH := ph
if not na(pl)
    lastSwingL := pl

plot(lastSwingH, "Swing High", color.new(color.lime, 50), style=plot.style_circles)
plot(lastSwingL, "Swing Low",  color.new(color.red,  50), style=plot.style_circles)

// ───────────── LIQUIDITY SWEEP ─────────────
// Bearish sweep: high pierces lastSwingH, close back below it (wick liquidity grab)
bearSweep = not na(lastSwingH) and high > lastSwingH and close < lastSwingH
// Bullish sweep: low pierces lastSwingL, close back above it
bullSweep = not na(lastSwingL) and low  < lastSwingL and close > lastSwingL

// ───────────── FAIR VALUE GAP (FVG) ─────────────
// Bullish FVG: low of current bar > high of bar 2 back  → gap (imbalance up)
// Bearish FVG: high of current bar < low of bar 2 back  → gap (imbalance down)
bullFVG = low  > high[2] and (low  - high[2]) >= atr * fvgMinATR
bearFVG = high < low[2]  and (low[2] - high ) >= atr * fvgMinATR

var float bullFVGtop = na, var float bullFVGbot = na, var int bullFVGbar = na
var float bearFVGtop = na, var float bearFVGbot = na, var int bearFVGbar = na

if bullFVG
    bullFVGtop := low
    bullFVGbot := high[2]
    bullFVGbar := bar_index
if bearFVG
    bearFVGtop := low[2]
    bearFVGbot := high
    bearFVGbar := bar_index

// Draw FVG boxes
var box bullBox = na
var box bearBox = na
if bullFVG
    bullBox := box.new(bar_index-2, bullFVGtop, bar_index+20, bullFVGbot,
                       border_color=color.new(color.green,60), bgcolor=color.new(color.green,85))
if bearFVG
    bearBox := box.new(bar_index-2, bearFVGtop, bar_index+20, bearFVGbot,
                       border_color=color.new(color.red,60), bgcolor=color.new(color.red,85))

// ───────────── ENTRY LOGIC ─────────────
// Long: bullish sweep occurred recently AND price retests a bull FVG from above
sweepRecentBull = ta.barssince(bullSweep) <= lookback
sweepRecentBear = ta.barssince(bearSweep) <= lookback

retestBullFVG = not na(bullFVGtop) and low <= bullFVGtop and low >= bullFVGbot and close > bullFVGbot
retestBearFVG = not na(bearFVGbot) and high >= bearFVGbot and high <= bearFVGtop and close < bearFVGtop

longCond  = inSess and sweepRecentBull and retestBullFVG and close > ema200
shortCond = inSess and sweepRecentBear and retestBearFVG and close < ema200

// Only one position at a time
canTrade = strategy.position_size == 0

if longCond and canTrade
    sl  = bullFVGbot - atr * slBufATR
    risk = close - sl
    tp1 = close + risk * tp1R
    tp2 = close + risk * tp2R
    strategy.entry("L", strategy.long)
    strategy.exit("L-TP1", from_entry="L", qty_percent=tp1Pct, limit=tp1, stop=sl)
    strategy.exit("L-TP2", from_entry="L", limit=tp2, stop=sl)

if shortCond and canTrade
    sl  = bearFVGtop + atr * slBufATR
    risk = sl - close
    tp1 = close - risk * tp1R
    tp2 = close - risk * tp2R
    strategy.entry("S", strategy.short)
    strategy.exit("S-TP1", from_entry="S", qty_percent=tp1Pct, limit=tp1, stop=sl)
    strategy.exit("S-TP2", from_entry="S", limit=tp2, stop=sl)

// Close at end of session
if not inSess and strategy.position_size != 0
    strategy.close_all(comment="EOD")

// ───────────── Alerts ─────────────
if alertOn and longCond and canTrade
    alert("🟢 STRAT3 SMC LONG " + syminfo.ticker + " @ " + str.tostring(close,"#.##"),
          alert.freq_once_per_bar_close)
if alertOn and shortCond and canTrade
    alert("🔴 STRAT3 SMC SHORT " + syminfo.ticker + " @ " + str.tostring(close,"#.##"),
          alert.freq_once_per_bar_close)

plotshape(bullSweep, "Bull Sweep", shape.labelup,   location.belowbar, color.aqua,   text="SWEEP", size=size.tiny)
plotshape(bearSweep, "Bear Sweep", shape.labeldown, location.abovebar, color.orange, text="SWEEP", size=size.tiny)
plotshape(longCond,  "L", shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(shortCond, "S", shape.triangledown, location.abovebar, color.red,  size=size.small)
bgcolor(inSess ? color.new(color.green, 95) : na)
