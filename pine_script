// Profile calculation function
f_calc_profile(prices, vols, rows_count) =>
    if array.size(prices) == 0
        [na, na, na]
    else
        float hi = array.max(prices)
        float lo = array.min(prices)
        float binWidth = hi == lo ? 0.01 : (hi - lo) / rows_count
        float[] binVolume = array.new_float(rows_count, 0.0)
        
        for i = 0 to array.size(prices) - 1
            float p = array.get(prices, i)
            float v = array.get(vols, i)
            int binIdx = int((p - lo) / binWidth)
            binIdx := math.max(0, math.min(rows_count - 1, binIdx))
            array.set(binVolume, binIdx, array.get(binVolume, binIdx) + v)
            
        float maxVol = 0.0
        int pocIdx = 0
        float totalVolume = 0.0
        for r = 0 to rows_count - 1
            float vol = array.get(binVolume, r)
            totalVolume := totalVolume + vol
            if vol > maxVol
                maxVol := vol
                pocIdx := r
                
        float targetVolume = totalVolume * 0.70
        float vaVolume = array.get(binVolume, pocIdx)
        int minVAIdx = pocIdx
        int maxVAIdx = pocIdx
        
        int safety = 0
        while vaVolume < targetVolume and safety < rows_count
            float aboveVol = (maxVAIdx < rows_count - 1) ? array.get(binVolume, maxVAIdx + 1) : 0.0
            float belowVol = (minVAIdx > 0) ? array.get(binVolume, minVAIdx - 1) : 0.0
            if aboveVol == 0.0 and belowVol == 0.0
                break
            if aboveVol >= belowVol
                maxVAIdx := maxVAIdx + 1
                vaVolume := vaVolume + aboveVol
            else
                minVAIdx := minVAIdx - 1
                vaVolume := vaVolume + belowVol
            safety := safety + 1
            
        float val = lo + minVAIdx * binWidth
        float vah = lo + (maxVAIdx + 1) * binWidth
        float poc = lo + pocIdx * binWidth + (binWidth / 2.0)
        [vah, val, poc]

