// CPR MASTER — ALL-IN-ONE INDICATOR WITH 1H ORDER FLOW
// ---------------------------------------------------------------------
// Modules (toggle each in settings):
//    A. RSI with live OB/OS label (shows value when ≥70 or ≤30)
//    B. EMA 200 + EMA 20
//    C. Auto Support / Resistance zones (pivot swings)
//    D. Virgin CPR — yesterday's TC / Pivot / BC plotted as a
//       horizontal line that EXTENDS RIGHT until any candle touches it.
//       Once touched the line stops extending (turns gray dashed).
//    E. Friday Gold Buy signal — bullish BC touch + reversal on Friday
//    F. Bonus extras: daily VWAP, weekly pivot, ATR value
//    G. Dashboard (top-right) with everything live
//    H. Trend Change Detector (daily, clean v2)
//    I. Volume Profile (Daily History POC/VAH/VAL on every day) - IST based
//    J. Last 5 Hours Order Flow Dashboard (bottom-right) - IST based
// =====================================================================
//@version=5
indicator("CPR Master · ALL-IN-ONE (IST 1H Order Flow)", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

// ─────────────────────────── TOGGLES
gT = "Modules ON/OFF"
mRSI    = input.bool(true,  "A. RSI label",         group=gT)
mEMA    = input.bool(true,  "B. EMA 20 / 200",       group=gT)
mSR     = input.bool(true,  "C. Support / Resistance zones", group=gT)
mVCPR   = input.bool(true,  "D. Virgin CPR lines",   group=gT)
mFRI    = input.bool(true,  "E. Friday Gold Buy",    group=gT)
mVWAP   = input.bool(true,  "F. Daily VWAP",         group=gT)
mWPIV   = input.bool(true,  "F. Weekly pivot",       group=gT)
mMPIV   = input.bool(true,  "F. Monthly pivot",      group=gT)
mTREND  = input.bool(true,  "H. Trend Change Detector", group=gT)
mDash   = input.bool(true,  "G. Dashboard",          group=gT)

// ─────────────────────────── RSI INPUTS
gR = "A · RSI"
rsiLen   = input.int(14,    "RSI length",  group=gR)
rsiOB    = input.float(70,  "Overbought",  group=gR)
rsiOS    = input.float(30,  "Oversold",    group=gR)

// ─────────────────────────── EMA INPUTS
gE = "B · EMA"
ema20Len  = input.int(20,   "EMA fast", group=gE)
ema200Len = input.int(200,  "EMA slow", group=gE)

// ─────────────────────────── SR INPUTS
gS = "C · Support / Resistance"
srLook    = input.int(50,   "Pivot lookback (bars)", group=gS)
srStrength= input.int(3,    "Pivot strength (bars left/right)", group=gS)
srMax     = input.int(4,    "Max zones each side", group=gS, minval=1, maxval=10)

// ─────────────────────────── VIRGIN CPR INPUTS
gV = "D · Virgin CPR"
vLook    = input.int(7,     "Keep virgin bands from last N days", group=gV, minval=1, maxval=20)

// ─────────────────────────── FRIDAY GOLD INPUTS
gF = "E · Friday Gold Buy"
friBCBand = input.float(0.5, "BC touch tolerance × ATR", step=0.1, group=gF)
friNeedRev= input.bool(true,"Require bullish reversal candle", group=gF)
friRSImax = input.float(60, "RSI must be <", group=gF)
friAboveEMA200 = input.bool(true, "Price > EMA200 required", group=gF)
friSession= input.session("0700-1500","London session window (filter)", group=gF)

// ─────────────────────────── TREND CHANGE INPUTS
gH = "H · Trend Change Detector"
tcWidthBars   = input.int(4,   "CPR width window (days)", group=gH, minval=3, maxval=10)
tcPivotBars   = input.int(3,   "Pivot migration window (days)", group=gH, minval=2, maxval=10)
tcRsiHigh     = input.float(60,"RSI was high above",  group=gH)
tcRsiLow      = input.float(40,"RSI now flips below", group=gH)
tcRsiBars     = input.int(5,   "RSI sustained for N bars", group=gH)
tcStructBars  = input.int(5,   "Pivot strength for HH/LL detection", group=gH)
tcMinScore    = input.int(3,   "Min signals to flag TREND CHANGE", group=gH, minval=1, maxval=6)
tcShowDaily   = input.bool(true, "Show daily score badge (every day)", group=gH)

// ─────────────────────────── VOLUME PROFILE INPUTS
gVP = "I · Volume Profile (Daily History)"
vpBins   = input.int(24,    "Volume Profile Rows (Bins)", group=gVP, minval=5, maxval=50)
vpHistDays = input.int(30,  "Historical days to keep on chart", group=gVP, minval=5, maxval=200)
vpHistLblOn = input.bool(true, "Show Historical Labels", group=gVP)

// Today's VP styling
vpPocColor = input.color(color.yellow,  "Today POC Color",    group=gVP, inline="tp")
vpPocWidth = input.int(2,               "Width",             group=gVP, inline="tp")
vpPocStyle = input.string("solid",      "Style",             group=gVP, inline="tp", options=["off","solid","dashed","dotted"])
vpVaColor  = input.color(color.blue,    "Today VAH/VAL Color", group=gVP, inline="tv")
vpVaWidth  = input.int(2,               "Width",             group=gVP, inline="tv")
vpVaStyle  = input.string("dashed",     "Style",             group=gVP, inline="tv", options=["off","solid","dashed","dotted"])

// Yesterday's VP styling
pdPocColor = input.color(color.orange,  "Yday POC Color",     group=gVP, inline="yp")
pdPocWidth = input.int(2,               "Width",             group=gVP, inline="yp")
pdPocStyle = input.string("solid",      "Style",             group=gVP, inline="yp", options=["off","solid","dashed","dotted"])
pdVaColor  = input.color(color.teal,    "Yday VAH/VAL Color", group=gVP, inline="yv")
pdVaWidth  = input.int(1,               "Width",             group=gVP, inline="yv")
pdVaStyle  = input.string("dotted",     "Style",             group=gVP, inline="yv", options=["off","solid","dashed","dotted"])

// ─────────────────────────── ORDER FLOW TABLE INPUTS
gOF = "J · 1H Order Flow Table Settings"
showTable = input.bool(true, "Show 1H Order Flow Table (Bottom-Right)", group=gOF)

// Helper mapping styles
f_lineStyle(s) =>
    s == "solid"  ? line.style_solid  : s == "dashed" ? line.style_dashed : s == "dotted" ? line.style_dotted : line.style_solid
f_on(s) => s != "off"

// ─────────────────────────── CORE INDICATORS
ema20   = ta.ema(close, ema20Len)
ema200  = ta.ema(close, ema200Len)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(14)

// ─────────────────────────── A · RSI live OB/OS labels
plot(mRSI ? na : na)   // placeholder
var label rsiLbl = na
if mRSI
    if not na(rsiLbl)
        label.delete(rsiLbl)
    isOB = rsi >= rsiOB
    isOS = rsi <= rsiOS
    if isOB or isOS
        col = isOB ? color.red : color.lime
        txt = (isOB ? "RSI ▲ " : "RSI ▼ ") + str.tostring(rsi, "#.#")
        rsiLbl := label.new(bar_index, isOB ? high : low,
             text=txt, style=isOB ? label.style_label_down : label.style_label_up,
             color=col, textcolor=color.white, size=size.small,
             yloc=isOB ? yloc.abovebar : yloc.belowbar)

// ─────────────────────────── B · EMAs
plot(mEMA ? ema20  : na, "EMA20",  color=color.new(color.aqua,   0), linewidth=1)
plot(mEMA ? ema200 : na, "EMA200", color=color.new(color.orange, 0), linewidth=2)

// ─────────────────────────── C · SUPPORT / RESISTANCE ZONES
var float[] resVals = array.new_float(0)
var float[] supVals = array.new_float(0)
var line[]  srLines = array.new_line(0)
phNow = ta.pivothigh(high, srStrength, srStrength)
plNow = ta.pivotlow(low,   srStrength, srStrength)

if mSR and not na(phNow)
    array.push(resVals, phNow)
    if array.size(resVals) > srMax
        array.shift(resVals)

if mSR and not na(plNow)
    array.push(supVals, plNow)
    if array.size(supVals) > srMax
        array.shift(supVals)

if mSR and barstate.islast
    if array.size(srLines) > 0
        for i = 0 to array.size(srLines) - 1
            line.delete(array.get(srLines, i))
        array.clear(srLines)
    if array.size(resVals) > 0
        for k = 0 to array.size(resVals) - 1
            v = array.get(resVals, k)
            array.push(srLines, line.new(bar_index - srLook, v, bar_index + 10, v,
                 xloc=xloc.bar_index, color=color.new(color.red, 60),
                 style=line.style_dashed, width=1))
    if array.size(supVals) > 0
        for k = 0 to array.size(supVals) - 1
            v = array.get(supVals, k)
            array.push(srLines, line.new(bar_index - srLook, v, bar_index + 10, v,
                 xloc=xloc.bar_index, color=color.new(color.green, 60),
                 style=line.style_dashed, width=1))

// ─────────────────────────── D · VIRGIN CPR (ONE band per day)
yH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
yL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
yC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
piv = (yH + yL + yC) / 3.0
bc  = (yH + yL) / 2.0
tc  = 2.0 * piv - bc
isNewDay = ta.change(time("D", "Asia/Kolkata")) != 0

var box[]   vBox     = array.new_box(0)
var label[] vLabel   = array.new_label(0)
var float[] vTop     = array.new_float(0)
var float[] vBot     = array.new_float(0)
var bool[]  vTouched = array.new_bool(0)

if mVCPR and isNewDay
    top = math.max(tc, bc)
    bot = math.min(tc, bc)
    bx = box.new(left=bar_index, top=top, right=bar_index + 1, bottom=bot,
         xloc=xloc.bar_index, extend=extend.right,
         border_color=color.new(color.purple, 30),
         bgcolor=color.new(color.purple, 88))
    lb = label.new(bar_index, (top + bot) / 2.0, text="Virgin CPR",
         xloc=xloc.bar_index, style=label.style_label_left,
         color=color.new(color.purple, 20), textcolor=color.white, size=size.normal)
    array.push(vBox,     bx)
    array.push(vLabel,   lb)
    array.push(vTop,     top)
    array.push(vBot,     bot)
    array.push(vTouched, false)
    while array.size(vBox) > vLook
        b0 = array.shift(vBox)
        l0 = array.shift(vLabel)
        if not na(b0)
            box.delete(b0)
        if not na(l0)
            label.delete(l0)
        array.shift(vTop)
        array.shift(vBot)
        array.shift(vTouched)

virginTouchBuy  = false
virginTouchSell = false
if mVCPR and array.size(vBox) > 0
    for i = 0 to array.size(vBox) - 1
        if not array.get(vTouched, i)
            top = array.get(vTop, i)
            bot = array.get(vBot, i)
            bx  = array.get(vBox, i)
            lb  = array.get(vLabel, i)
            if not na(lb) and barstate.islast
                label.set_x(lb, bar_index + 4)
            if high >= bot and low <= top
                array.set(vTouched, i, true)
                box.set_extend(bx, extend.none)
                box.set_right(bx, bar_index)
                box.set_bgcolor(bx, color.new(color.gray, 85))
                box.set_border_color(bx, color.new(color.gray, 40))
                if not na(lb)
                    label.set_x(lb, bar_index)
                    label.set_y(lb, (top + bot) / 2.0)
                    label.set_text(lb, "✓")
                    label.set_color(lb, color.new(color.gray, 30))
                if close[1] > top
                    virginTouchBuy := true
                if close[1] < bot
                    virginTouchSell := true

body   = math.abs(close - open)
upWick = high - math.max(close, open)
loWick = math.min(close, open) - low
bullPin = close > open and loWick > body * 1.5
bearPin = close < open and upWick > body * 1.5
bullEng = close > open and close > high[1] and open <= close[1]
bearEng = close < open and close < low[1]  and open >= close[1]

virginBuySig  = virginTouchBuy  and (bullPin or bullEng) and rsi > 35
virginSellSig = virginTouchSell and (bearPin or bearEng) and rsi < 65

plotshape(mVCPR and virginBuySig,  "Virgin BUY",  style=shape.diamond, location=location.belowbar, color=color.new(color.lime,   0), size=size.small, text="👻BUY")
plotshape(mVCPR and virginSellSig, "Virgin SELL", style=shape.diamond, location=location.abovebar, color=color.new(color.maroon, 0), size=size.small, text="👻SELL")

// ─────────────────────────── E · FRIDAY GOLD BUY
isFriday   = dayofweek == dayofweek.friday
inFriSess  = not na(time(timeframe.period, friSession))
nearBC     = math.abs(low - bc) <= friBCBand * atr or (low <= bc and close >= bc)
revOK      = not friNeedRev or (bullPin or bullEng or close > open)
rsiOK      = rsi < friRSImax
emaOK      = not friAboveEMA200 or close > ema200
wedClose = request.security(syminfo.tickerid, "D", close[3], lookahead=barmerge.lookahead_on)
thuClose = request.security(syminfo.tickerid, "D", close[2], lookahead=barmerge.lookahead_on)
sidewaysOrDown = thuClose <= wedClose

fridayBuy = mFRI and isFriday and inFriSess and nearBC and revOK and rsiOK and emaOK and sidewaysOrDown
plotshape(fridayBuy, "Friday Gold BUY", style=shape.triangleup, location=location.belowbar,
     color=color.new(#FFD700, 0), size=size.normal, text="FRI🪙")
bgcolor(mFRI and isFriday ? color.new(color.yellow, 92) : na, title="Friday tint")

// ─────────────────────────── F · DAILY VWAP + WEEKLY PIVOT
vwap = ta.vwap(hlc3, isNewDay ? 1 : 0)
plot(mVWAP ? vwap : na, "Daily VWAP", color=color.new(color.purple, 0), linewidth=1)

wH = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_on)
wL = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_on)
wC = request.security(syminfo.tickerid, "W", close[1], lookahead=barmerge.lookahead_on)
wPivot = (wH + wL + wC) / 3.0
plot(mWPIV ? wPivot : na, "Weekly Pivot", color=color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)

mH = request.security(syminfo.tickerid, "M", high[1],  lookahead=barmerge.lookahead_on)
mL = request.security(syminfo.tickerid, "M", low[1],   lookahead=barmerge.lookahead_on)
mC = request.security(syminfo.tickerid, "M", close[1], lookahead=barmerge.lookahead_on)
mPivot = (mH + mL + mC) / 3.0
mR1    = 2.0 * mPivot - mL
mS1    = 2.0 * mPivot - mH
plot(mMPIV ? mPivot : na, "Monthly Pivot", color=color.new(color.fuchsia, 0), linewidth=3, style=plot.style_linebr)
plot(mMPIV ? mR1    : na, "Monthly R1",    color=color.new(color.fuchsia, 50), linewidth=1, style=plot.style_linebr)
plot(mMPIV ? mS1    : na, "Monthly S1",    color=color.new(color.fuchsia, 50), linewidth=1, style=plot.style_linebr)

// ─────────────────────────── H · TREND CHANGE DETECTOR (DAILY, CLEAN v2)
dClose  = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
dEma20  = request.security(syminfo.tickerid, "D", ta.ema(close, ema20Len)[1],  lookahead=barmerge.lookahead_on)
dEma200 = request.security(syminfo.tickerid, "D", ta.ema(close, ema200Len)[1], lookahead=barmerge.lookahead_on)
dRsi    = request.security(syminfo.tickerid, "D", ta.rsi(close, rsiLen)[1],    lookahead=barmerge.lookahead_on)
dHigh   = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
dLow    = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
todayWidth = math.abs(tc - bc)

var float[] wHist     = array.new_float(0)
var float[] pHist     = array.new_float(0)
var float[] cHist     = array.new_float(0)
var float[] e20Hist   = array.new_float(0)
var float[] e200Hist  = array.new_float(0)
var float[] rsiHist   = array.new_float(0)
var float[] hHist     = array.new_float(0)
var float[] lHist     = array.new_float(0)

if isNewDay
    array.push(wHist,    todayWidth)
    array.push(pHist,    piv)
    array.push(cHist,    dClose)
    array.push(e20Hist,  dEma20)
    array.push(e200Hist, dEma200)
    array.push(rsiHist,  dRsi)
    array.push(hHist,    dHigh)
    array.push(lHist,    dLow)
    while array.size(wHist) > 30
        array.shift(wHist)
        array.shift(pHist)
        array.shift(cHist)
        array.shift(e20Hist)
        array.shift(e200Hist)
        array.shift(rsiHist)
        array.shift(hHist)
        array.shift(lHist)

var int    trendScore      = 0
var int    trendVote       = 0
var string trendNote       = ""
var bool   trendChangeBear = false
var bool   trendChangeBull = false

f_get(a, idxFromEnd) =>
    sz = array.size(a)
    idx = sz - 1 - idxFromEnd
    idx >= 0 ? array.get(a, idx) : na

if isNewDay and array.size(cHist) >= 2
    bool widthFlip = false
    int  widthDir  = 0
    if array.size(wHist) >= 4
        w1 = f_get(wHist, 3)
        w2 = f_get(wHist, 2)
        w3 = f_get(wHist, 1)
        w4 = f_get(wHist, 0)
        if w2 > w1 and w3 > w2 and w4 < w3
            widthFlip := true
            widthDir  := 1
        if w2 < w1 and w3 < w2 and w4 > w3
            widthFlip := true
            widthDir  := -1
            
    bool pivFlip = false
    int  pivDir  = 0
    if array.size(pHist) >= tcPivotBars + 1
        pivNow = f_get(pHist, 0)
        pivOld = f_get(pHist, tcPivotBars)
        pxNow  = f_get(cHist, 0)
        pxOld  = f_get(cHist, tcPivotBars)
        priceDrift = pxNow  - pxOld
        pivDrift   = pivNow - pivOld
        if priceDrift > 0 and pivDrift < 0
            pivFlip := true
            pivDir  := 1
        if priceDrift < 0 and pivDrift > 0
            pivFlip := true
            pivDir  := -1
            
    bool emaCross = false
    int  emaDir   = 0
    e20Now  = f_get(e20Hist,  0)
    e20Prev = f_get(e20Hist,  1)
    e200Now = f_get(e200Hist, 0)
    e200Prev= f_get(e200Hist, 1)
    if not na(e20Prev) and not na(e200Prev)
        if e20Prev <= e200Prev and e20Now > e200Now
            emaCross := true
            emaDir   := -1
        if e20Prev >= e200Prev and e20Now < e200Now
            emaCross := true
            emaDir   := 1
            
    bool pxCross = false
    int  pxDir   = 0
    cPrev = f_get(cHist, 1)
    if not na(cPrev) and not na(e200Prev)
        if cPrev <= e200Prev and dClose > e200Now
            pxCross := true
            pxDir   := -1
        if cPrev >= e200Prev and dClose < e200Now
            pxCross := true
            pxDir   := 1
            
    bool rsiFlip = false
    int  rsiDir2 = 0
    if array.size(rsiHist) >= tcRsiBars + 1
        wasAllHigh = true
        wasAllLow  = true
        for k = 1 to tcRsiBars
            v = f_get(rsiHist, k)
            if na(v) or v <= tcRsiHigh
                wasAllHigh := false
            if na(v) or v >= tcRsiLow
                wasAllLow  := false
        if wasAllHigh and dRsi < tcRsiLow
            rsiFlip := true
            rsiDir2 := 1
        if wasAllLow and dRsi > tcRsiHigh
            rsiFlip := true
            rsiDir2 := -1
            
    bool structFlip = false
    int  structDir  = 0
    hPrev = f_get(hHist, 1)
    lPrev = f_get(lHist, 1)
    if not na(hPrev) and dHigh < hPrev and dClose < e20Now
        structFlip := true
        structDir  := 1
    if not na(lPrev) and dLow  > lPrev and dClose > e20Now
        structFlip := true
        structDir  := -1
        
    trendScore := (widthFlip?1:0) + (pivFlip?1:0) + (emaCross?1:0) + (pxCross?1:0) + (rsiFlip?1:0) + (structFlip?1:0)
    trendVote  := (widthFlip?widthDir:0) + (pivFlip?pivDir:0) + (emaCross?emaDir:0) + (pxCross?pxDir:0) + (rsiFlip?rsiDir2:0) + (structFlip?structDir:0)
    trendChangeBear := trendScore >= tcMinScore and trendVote > 0
    trendChangeBull := trendScore >= tcMinScore and trendVote < 0
    parts = ""
    parts := parts + (widthFlip  ? (widthDir>0?"W▲▼ "  :"W▼▲ ")    : "")
    parts := parts + (pivFlip    ? (pivDir>0?  "P↓ "    :"P↑ ")    : "")
    parts := parts + (emaCross   ? (emaDir>0?  "EMA✕↓ " :"EMA✕↑ ") : "")
    parts := parts + (pxCross    ? (pxDir>0?   "Px<200 ":"Px>200 "): "")
    parts := parts + (rsiFlip    ? (rsiDir2>0? "RSI↓ "  :"RSI↑ ")  : "")
    parts := parts + (structFlip ? (structDir>0?"LH "   :"HL ")    : "")
    trendNote := parts == "" ? "—" : parts

plotshape(mTREND and isNewDay and trendChangeBear, "Trend Change ↓", style=shape.labeldown,
     location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white,
     size=size.large, text="↓ TREND")
plotshape(mTREND and isNewDay and trendChangeBull, "Trend Change ↑", style=shape.labelup,
     location=location.belowbar, color=color.new(color.lime, 0), textcolor=color.black,
     size=size.large, text="↑ TREND")

if mTREND and tcShowDaily and isNewDay
    arrow = trendVote > 0 ? " ↓" : trendVote < 0 ? " ↑" : ""
    badgeTxt = str.tostring(trendScore) + "/6" + arrow
    badgeCol = trendChangeBear ? color.red :
               trendChangeBull ? color.lime :
               trendScore >= 2 ? color.orange :
               trendScore == 1 ? color.new(color.gray, 20) :
               color.new(color.gray, 50)
    label.new(bar_index, high, text=badgeTxt,
         style=label.style_label_down, yloc=yloc.abovebar,
         color=badgeCol, textcolor=color.white, size=size.small)

bgcolor(mTREND and trendChangeBear ? color.new(color.red,  94) : mTREND and trendChangeBull ? color.new(color.lime, 94) : na, title="Trend change day-tint")

alertcondition(mTREND and isNewDay and trendChangeBear, "Trend Change Bearish (daily)", "Top: trend changed DOWN today")
alertcondition(mTREND and isNewDay and trendChangeBull, "Trend Change Bullish (daily)", "Bottom: trend changed UP today")
alertcondition(virginBuySig,  "Virgin CPR Buy",  "BUY  : virgin CPR tagged from above")
alertcondition(virginSellSig, "Virgin CPR Sell", "SELL : virgin CPR tagged from below")
alertcondition(fridayBuy,     "Friday Gold Buy", "BUY  : Friday gold setup at BC")
alertcondition(rsi >= rsiOB,  "RSI Overbought",  "RSI overbought")
